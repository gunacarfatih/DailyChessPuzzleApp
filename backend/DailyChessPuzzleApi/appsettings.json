{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{CorrelationId}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "",
    "Redis": "localhost:6379,defaultDatabase=1"
  },
  "JwtSettings": {
    "Issuer": "DailyChessPuzzleApi",
    "Audience": "DailyChessPuzzleClient",
    "ExpirationMinutes": 60
  },
  "LeaderboardSettings": {
    "DefaultLimit": 50,
    "MinLimit": 1,
    "MaxLimit": 100
  },
  "CacheSettings": {
    "Provider": "Redis",
    "DurationMinutes": 60,
    "InstanceName": "DailyChessPuzzle_"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
