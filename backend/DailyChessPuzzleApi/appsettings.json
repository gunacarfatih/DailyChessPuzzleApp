{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{CorrelationId}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "",
    "Redis": "localhost:6379,defaultDatabase=1"
  },
  "JwtSettings": {
    "Issuer": "DailyChessPuzzleApi",
    "Audience": "DailyChessPuzzleClient",
    "ExpirationMinutes": 60
  },
  "LeaderboardSettings": {
    "DefaultLimit": 50,
    "MinLimit": 1,
    "MaxLimit": 100
  },
  "CacheSettings": {
    "Provider": "Redis",
    "DurationMinutes": 60,
    "InstanceName": "DailyChessPuzzle_"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "GoogleAuth": {
    "WebClientId": "50351820821-cfv637694e6k8nfjm8ve48s28u4o2pef.apps.googleusercontent.com"
  },
  "Scoring": {
    "MaximumScore": 1000,
    "MinimumSuccessfulScore": 100,
    "MaximumTimePenalty": 300,
    "MaximumWrongMovePenalty": 400,
    "HintPenalty": 200,
    "BaseReferenceTimeSeconds": 20,
    "MinimumRating": 800,
    "MaximumRating": 3200,
    "ReferenceRating": 800,
    "RatingScale": 1600,
    "TimePenaltyCoefficient": 150,
    "WrongMovePenaltyCoefficient": 50,
    "OpponentAnimationCompensationMilliseconds": 500,
    "MaximumServerCompensationPerRequestMilliseconds": 250,
    "MaximumServerCompensationPerSessionMilliseconds": 2000,
    "BonusTimeLimitSeconds": 300,
    "ScoreDecimalPlaces": 4
  },
  "AllowedHosts": "*"
}
